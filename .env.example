# Public content (SSR and unauthenticated browser calls) uses this origin.
# Authenticated browser calls stay on this site and never receive refresh tokens.
NEXT_PUBLIC_API_BASE_URL=https://api.pipsangel.com

# Optional server-only override for the auth BFF and authenticated proxy.
# When unset, the BFF uses NEXT_PUBLIC_API_BASE_URL.
# API_BASE_URL=https://api.pipsangel.com

# HttpOnly session cookies are Secure in production.
# Set explicitly when HTTPS is used outside production, or to force insecure cookies.
# AUTH_COOKIE_SECURE=true

# Local mock content. Leave unset against the real API.
# NEXT_PUBLIC_USE_MOCK_API=false

# Canonical site origin for metadata, sitemap and structured data.
# NEXT_PUBLIC_APP_URL=https://pipsangel.com

# Dev-only login hint shown in the login dialog. Ignored when NODE_ENV=production.
# Never put real credentials here.
# NEXT_PUBLIC_ENABLE_DEMO_CREDENTIALS=false
# NEXT_PUBLIC_DEMO_USER_EMAIL=
# NEXT_PUBLIC_DEMO_USER_PASSWORD=
